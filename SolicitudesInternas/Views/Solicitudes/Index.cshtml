@model SolicitudesInternas.ViewModels.SolicitudListadoViewModel
@{
    ViewBag.Title = "Solicitudes";
}

<h2>Solicitudes</h2>

<p>@Html.ActionLink("Nueva solicitud", "Crear", null, new { @class = "btn btn-primary" })</p>

<div class="panel panel-default">
    <div class="panel-heading">Consultar por responsable, estado y prioridad</div>
    <div class="panel-body">
        @using (Html.BeginForm("Index", "Solicitudes", FormMethod.Get, new { @class = "form-inline" }))
        {
            <div class="form-group">
                <label for="ResponsableId">Responsable</label>
                @Html.DropDownListFor(m => m.ResponsableId, Model.Responsables, "Todos", new { @class = "form-control" })
            </div>
            <div class="form-group">
                <label for="Estado">Estado</label>
                @Html.EnumDropDownListFor(m => m.Estado, "Todos", new { @class = "form-control" })
            </div>
            <div class="form-group">
                <label for="Prioridad">Prioridad</label>
                @Html.EnumDropDownListFor(m => m.Prioridad, "Todas", new { @class = "form-control" })
            </div>
            <button type="submit" class="btn btn-default">Filtrar</button>
            @Html.ActionLink("Limpiar", "Index", null, new { @class = "btn btn-link" })
        }
    </div>
</div>

@if (Model.Solicitudes.Count == 0)
{
    <div class="alert alert-info">No se encontraron solicitudes con los filtros seleccionados.</div>
}
else
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>#</th>
                <th>Solicitante</th>
                <th>Categoría</th>
                <th>Descripción</th>
                <th>Prioridad</th>
                <th>Estado</th>
                <th>Responsable</th>
                <th>Creada</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Solicitudes)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Solicitante.Nombre</td>
                    <td>@item.TipoSolicitud.Nombre</td>
                    <td>@(item.Descripcion.Length > 60 ? item.Descripcion.Substring(0, 60) + "..." : item.Descripcion)</td>
                    <td><span class="@item.Prioridad.ClaseCss()">@item.Prioridad.Descripcion()</span></td>
                    <td><span class="@item.Estado.ClaseCss()">@item.Estado.Descripcion()</span></td>
                    <td>@(item.Responsable != null ? item.Responsable.Nombre : "Sin asignar")</td>
                    <td>@item.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@Html.ActionLink("Ver", "Detalle", new { id = item.Id }, new { @class = "btn btn-xs btn-default" })</td>
                </tr>
            }
        </tbody>
    </table>
    <p class="text-muted">@Model.Solicitudes.Count solicitud(es) encontrada(s).</p>
}
