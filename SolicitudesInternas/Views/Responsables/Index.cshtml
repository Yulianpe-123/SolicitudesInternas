@model IEnumerable<SolicitudesInternas.Models.Responsable>
@{
    ViewBag.Title = "Responsables";
}

<h2>Responsables</h2>
<p>@Html.ActionLink("Nuevo responsable", "Crear", null, new { @class = "btn btn-primary" })</p>

<table class="table table-striped">
    <thead>
        <tr><th>Nombre</th><th>Correo</th><th>Especialidad</th><th>Estado</th><th></th></tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Nombre</td>
                <td>@item.Correo</td>
                <td>@item.Especialidad</td>
                <td>
                    @if (item.Activo) { <span class="label label-success">Activo</span> }
                    else { <span class="label label-default">Inactivo</span> }
                </td>
                <td>
                    @Html.ActionLink("Editar", "Editar", new { id = item.Id }, new { @class = "btn btn-xs btn-default" })
                    @Html.ActionLink("Sus solicitudes", "Index", "Solicitudes", new { responsableId = item.Id }, new { @class = "btn btn-xs btn-info" })
                </td>
            </tr>
        }
    </tbody>
</table>
